{
  "name": "rothello",
  "version": "1.0.0",
  "description": "Lichess-style modern UI and NBoard protocol engine for Othello",
  "main": "server/index.ts",
  "scripts": {
    "dev": "concurrently -n \"server,ui\" -c \"yellow,blue\" \"npm run server\" \"npm run ui\"",
    "server": "tsx server/index.ts",
    "ui": "vite",
    "build:engine": "cargo build --release --manifest-path engine/Cargo.toml",
    "build": "tsc && vite build",
    "build:all": "npm run build:engine && npm run build",
    "test:engine": "cargo test --manifest-path engine/Cargo.toml",
    "test:ui": "tsc --noEmit",
    "test:integration": "npm run build:engine && tsx server/test-integration.ts",
    "test": "npm run test:engine && npm run test:ui && npm run test:integration",
    "preview": "vite preview"
  },
  "keywords": [
    "othello",
    "reversi",
    "nboard",
    "edax",
    "chess",
    "lichess"
  ],
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
